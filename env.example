# Base URL
NEXT_PUBLIC_SITE_URL=https://janidumihinwidanagamachchi.github.io/NC-WEB
# Path prefix when hosted under a subpath (e.g. GitHub Pages): /NC-WEB
NEXT_PUBLIC_BASE_PATH=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Facebook Graph API (server-side only)
FACEBOOK_PAGE_ID=NalandaCollegeColombo
FACEBOOK_ACCESS_TOKEN=

# Contact form (Web3Forms — static hosting friendly; key from https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Email (Resend — only used by the previous /api/contact route; no longer required)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@nalandacollege.lk
CONTACT_RECIPIENT_EMAIL=info@nalandacollege.lk

# Admin auth
AUTH_SECRET=
AUTH_ADMIN_EMAIL=admin@nalandacollege.lk
AUTH_ADMIN_PASSWORD= # set a strong password

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Rate limiting (optional; falls back to memory limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
